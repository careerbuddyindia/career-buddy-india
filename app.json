{
  "expo": {
    "name": "Career Buddy India",
    "slug": "careerbuddyindiaofficial",
    "owner": "careerbuddyindiaofficials-team",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpg",
    "scheme": "careerbuddyindia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.careerbuddyindia.app"
    },
    "android": {
      "package": "com.careerbuddyindia.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.jpg",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_PROJECT_ID_HERE"
      }
    }
  }
}
